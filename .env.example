# Copy this file to .env before running Docker Compose.
MRBS_HTTP_PORT=8080
PHPMYADMIN_PORT=8888
MRBS_TIMEZONE=America/New_York

# Leave this as mrbs_ unless you also update the SQL schema file.
MRBS_DB_TBL_PREFIX=mrbs_

MYSQL_DATABASE=mrbs
MYSQL_USER=mrbs
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-root-to-a-strong-password

# Set to 1 only if you want demo/sample bookings loaded on first schema creation.
MRBS_LOAD_SAMPLE_BOOKINGS=0
