# Copy this file to .env before running Docker Compose.
MRBS_HTTP_PORT=8080
PHPMYADMIN_PORT=8888
MRBS_TIMEZONE=America/New_York

# MRBS database settings used by BOTH the PHP app and the MySQL container.
MRBS_DB_SYSTEM=mysql
MRBS_DB_HOST=db
MRBS_DB_DATABASE=mrbs
MRBS_DB_USER=mrbs
MRBS_DB_PASSWORD=change-me-to-a-strong-password

# MySQL root password, used only inside the database container.
MYSQL_ROOT_PASSWORD=change-root-to-a-strong-password

# Leave this as mrbs_ unless you also update the SQL schema file.
MRBS_DB_TBL_PREFIX=mrbs_

# Set to 1 only if you want demo/sample bookings loaded on first schema creation.
MRBS_LOAD_SAMPLE_BOOKINGS=0
